# ==========================================
# Production Mode Configuration
# Prevents local development URLs in .env from leaking into production builds.
# Supply real HTTPS/WSS endpoints via CI/CD env vars or .env.production.local:
#   VITE_BACKEND_URL=https://api.your-domain.com
# ==========================================
VITE_APP_ENV=production
VITE_BACKEND_URL=
VITE_API_BASE_URL=${VITE_BACKEND_URL}
VITE_WS_URL=${VITE_BACKEND_URL}
VITE_WS_PATH=/socket.io
VITE_WS_NAMESPACE=/telemetry
VITE_API_TIMEOUT=30000
VITE_PROXY_TARGET=
