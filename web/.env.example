# ==========================================
# AquaSense Frontend Environment Template
# Copy to .env for local development. Do NOT store secrets in VITE_* variables.
# ==========================================

# ==========================================
# APPLICATION
# ==========================================
VITE_APP_NAME=AquaSense
VITE_APP_ENV=development

# ==========================================
# FRONTEND SERVER (Vite dev & preview)
# ==========================================
VITE_HOST=localhost
VITE_PORT=5173
VITE_STRICT_PORT=true
VITE_PREVIEW_PORT=4173

# ==========================================
# BACKEND CONNECTION
# Note: Backend exposes REST routes at root (e.g. /auth/login, /ponds);
# only Swagger UI is mounted at /api/docs. Do NOT append /api unless behind a /api proxy.
# ==========================================
VITE_BACKEND_URL=http://localhost:3000
VITE_API_BASE_URL=${VITE_BACKEND_URL}

# ==========================================
# WEBSOCKET (Socket.IO)
# ==========================================
VITE_WS_URL=${VITE_BACKEND_URL}
VITE_WS_PATH=/socket.io
VITE_WS_NAMESPACE=/telemetry

# ==========================================
# HTTP CONFIGURATION (milliseconds)
# ==========================================
VITE_API_TIMEOUT=30000

# ==========================================
# DEVELOPMENT PROXY
# ==========================================
VITE_PROXY_TARGET=${VITE_BACKEND_URL}
